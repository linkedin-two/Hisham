# ==============================================================================
# Edvoyage Backend Docker Environment Variables
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=edvoyage-ec2-production-key-change-me-to-a-long-random-string
DJANGO_DEBUG=False

# Allowed Hosts (include your DuckDNS domain, internal container names, and localhost)
ALLOWED_HOSTS=edvoyage.duckdns.org,localhost,127.0.0.1,edvoyage,reverse-proxy,*

# CORS & CSRF Configuration
CORS_ALLOWED_ORIGINS=https://edvoyage.duckdns.org,https://edzkool.duckdns.org,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://edvoyage.duckdns.org,https://edzkool.duckdns.org

# Database Configuration (Leave empty to use local SQLite, or set Supabase/PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# Optional S3 Media Storage
# AWS_STORAGE_BUCKET_NAME=edvoyage-edzkool-media
# AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
