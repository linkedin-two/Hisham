# ==============================================================================
# Edzkool Backend Docker Environment Variables
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=edzkool-ec2-production-key-change-me-to-a-long-random-string
DJANGO_DEBUG=False

# Allowed Hosts (include your DuckDNS domain, internal container names, and localhost)
ALLOWED_HOSTS=edzkool.duckdns.org,localhost,127.0.0.1,edzkool,reverse-proxy,*

# CORS & CSRF Configuration
CORS_ALLOWED_ORIGINS=https://edzkool.duckdns.org,https://edvoyage.duckdns.org,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://edzkool.duckdns.org,https://edvoyage.duckdns.org

# Database Configuration:
# Leave DATABASE_URL commented out to use SQLite (stored in container / volume)
# Or uncomment and fill with your PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Media & Storage:
# Set USE_S3=True if storing media files on AWS S3
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=edvoyage-edzkool-media
AWS_S3_REGION_NAME=us-east-1

# Optional Email Settings (AWS SES or SMTP)
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=office@bfuturetechnologies.com

# Optional Database Seeding (set to true on initial run if dummy data is desired)
SEED_DATABASE=False
