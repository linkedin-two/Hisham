# Copy to android/key.properties and fill in values. Never commit key.properties.
storePassword=your-keystore-password
keyPassword=your-key-password
keyAlias=edzkool
storeFile=../edzkool-release.keystore

# Generate keystore:
# keytool -genkey -v -keystore edzkool-release.keystore -alias edzkool -keyalg RSA -keysize 2048 -validity 10000
